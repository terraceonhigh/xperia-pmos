#!/sbin/openrc-run

description="Enable the s6sy761 touchscreen (AVDD hold, reset, rebind)"

depend() {
	# after greetd on purpose: on Mobian, enabling touch before the compositor was
	# up did not stick -- phoc coming up crashes the I2C DMA controller and takes
	# touch with it (the same reason `restart phosh` is banned in favour of a
	# reboot). greetd provides display-manager, so this orders us behind it.
	after modules udev udev-settle greetd
	need localmount
}

start() {
	ebegin "Enabling touchscreen"
	# Everything is teed to a file on the rootfs on purpose. Under hybrid boot the
	# phone has no usable network from a Mac (RNDIS only) and, before Phosh is
	# installed, nothing on screen either -- so the only way to find out what
	# happened is to power down, pull the SD card and read this log.
	mkdir -p /var/log
	/usr/local/bin/enable-touch.py > /var/log/enable-touch.log 2>&1
	rc=$?
	{
		echo "--- exit status: $rc"
		echo "--- kernel: $(uname -r)"
		echo "--- dmesg (s6sy761) ---"
		dmesg | grep -i s6sy
		echo "--- dmesg (i2c errors) ---"
		dmesg | grep -iE "i2c|geni" | tail -20
		echo "--- input devices ---"
		cat /proc/bus/input/devices

		# The driver's probe died in devm_request_threaded_irq with -EINVAL, on a
		# kernel and DT node byte-identical to ones where it worked -- so the cause
		# is runtime state, and these three dumps are what distinguish the
		# possibilities: whether the touch interrupt got a virq at all, whether
		# gpio22 is claimed by something, and what direction/value the lines hold.
		echo "--- /proc/interrupts ---"
		cat /proc/interrupts
		echo "--- gpio state (needs debugfs) ---"
		mount -t debugfs none /sys/kernel/debug 2>/dev/null
		# gpiochip1's base is 521, so the touch lines are gpio-531/542/543 -- an earlier
		# grep for "gpio-1x/2x" matched nothing and threw the dump away.
		cat /sys/kernel/debug/gpio 2>&1 | head -40
		echo "--- irq domains ---"
		cat /sys/kernel/debug/irq/domains/default 2>&1 | head -10
		echo "--- does the DT node carry an interrupt? ---"
		od -An -tx1 /sys/firmware/devicetree/base/soc@0/geniqup@9c0000/i2c@988000/touchscreen@48/interrupts 2>&1 | head -2
	} >> /var/log/enable-touch.log 2>&1
	# This log is the only channel out of the device, and reading it means force
	# powering the phone off and pulling the card. Commit it now rather than
	# trusting the writeback interval to beat the power cut.
	sync
	eend $rc
}
